# ── Web app data sources ────────────────────────────────
PLAID_CLIENT_ID=
PLAID_CLIENT_SECRET=          # production secret; set PLAID_ENV=sandbox to use a sandbox one
NEWS_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
TICKETMASTER_API_KEY=
TICKETMASTER_CONSUMER_SECRET=

# ── API (packages/api) ──────────────────────────────────
# Firebase service account for Firestore + Auth. Local only — deployed
# functions use Application Default Credentials and ignore these.
APP_FIREBASE_PROJECT_ID=
APP_FIREBASE_CLIENT_EMAIL=
APP_FIREBASE_PRIVATE_KEY=     # keep the literal \n sequences; the loader unescapes them
# Firebase Auth uid of the one human allowed through "owner" endpoints.
MYOS_OWNER_UID=
# Long random secret, prefixed myos_, for scripts and agents calling the API.
MYOS_API_KEY=
# Where the web app reaches the API (server-side only).
MYOS_API_URL=http://localhost:8787
# Local listen port for `pnpm api dev`.
PORT=8787
