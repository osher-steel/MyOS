      "boundElements": [],
      "updated": 1789437370949,
      "link": null,
      "locked": false,
      "text": "Analytics\n\nGoal: watch budget month over month\n- budget changes\n- savings amount\n- buckets overdrawn\n- savings and balance growth",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Analytics\n\nGoal: watch budget month over month\n- budget changes\n- savings amount\n- buckets overdrawn\n- savings and balance growth",
      "autoResize": true,
      "lineHeight": 1.25
    },
