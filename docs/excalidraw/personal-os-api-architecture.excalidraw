  },
  {
   "type": "text",
   "id": "note_7",
   "x": 80,
   "y": 1491,
   "width": 1029,
   "height": 16,
   "text": "6   Balances are never stored.  Live Plaid is the source of truth, and drift (ledger vs reality) is the signal that the buckets lie.",
   "originalText": "6   Balances are never stored.  Live Plaid is the source of truth, and drift (ledger vs reality) is the signal that the buckets lie.",
