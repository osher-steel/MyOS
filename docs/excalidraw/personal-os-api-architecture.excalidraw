   "lineHeight": 1.25
  },
  {
   "type": "text",
   "id": "note_6",
   "x": 80,
   "y": 1470,
   "width": 943,
   "height": 16,
   "text": "5   budgetSnapshots carries a per-category breakdown, not just totals \u2014 that is what the month-end over/under view reads.",
   "originalText": "5   budgetSnapshots carries a per-category breakdown, not just totals \u2014 that is what the month-end over/under view reads.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
